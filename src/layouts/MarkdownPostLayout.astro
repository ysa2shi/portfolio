---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDateJST } from "@/utils/formatDate";
import Tag from "@/components/Tag.astro";
import "@/styles/link-card.css";

const { frontmatter } = Astro.props;
const formattedDate = formatDateJST(frontmatter.publishDate);
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="mx-auto max-w-3xl px-4 pb-16 pt-8">
    {
      frontmatter.image && (
        <img
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
          class="mb-8 h-[400px] w-full rounded-2xl border border-line object-cover"
          loading="eager"
        />
      )
    }
    <header class="mb-12">
      <h1 class="mb-4 text-2xl font-bold md:text-4xl">
        {frontmatter.title}
      </h1>
      <div class="mb-6 flex flex-wrap items-center gap-4 text-sub">
        <time datetime={frontmatter.publishDate} class="flex items-center">
          {formattedDate.slice(0, 4)}年{formattedDate.slice(5, 7)}月{
            formattedDate.slice(8, 10)
          }
        </time>
      </div>
      {
        frontmatter.tags && (
          <div class="flex flex-wrap gap-2">
            {frontmatter.tags.map((tag: string) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        )
      }
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* Markdown本文のスタイル(色は theme.css のトークン) */
  .post-body {
    font-size: 1.0625rem;
    line-height: 1.95;
    color: rgb(var(--c-ink));
  }
  .post-body :global(p) {
    margin: 1.25em 0;
  }
  .post-body :global(a) {
    color: rgb(var(--c-accent));
    text-decoration: none;
  }
  .post-body :global(a:hover) {
    text-decoration: underline;
  }
  .post-body :global(strong) {
    font-weight: 700;
  }
  .post-body :global(img) {
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--c-line));
  }
  .post-body :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid rgb(var(--c-line));
  }

  /* インラインコード */
  .post-body :global(code:not(pre code)) {
    padding: 0.15em 0.45em;
    background-color: rgb(var(--c-surface));
    border: 1px solid rgb(var(--c-line));
    border-radius: 0.375em;
    font-size: 0.875em;
  }

  /* コードブロック(Shiki のテーマ色は暗いままにして、枠だけ合わせる) */
  .post-body :global(pre) {
    margin: 1.6em 0;
    padding: 1em 1.2em;
    border: 1px solid rgb(var(--c-line));
    border-radius: 0.75rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* 見出し */
  .post-body :global(h1) {
    font-size: 2.5em;
    margin-top: 0;
    margin-bottom: 0.8em;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .post-body :global(h2) {
    font-size: 1.875em;
    margin-top: 2em;
    margin-bottom: 1em;
    font-weight: 600;
    line-height: 1.3;
    border-bottom: 1px solid rgb(var(--c-line));
    padding-bottom: 0.5em;
  }
  .post-body :global(h2::before) {
    content: "✦";
    color: rgb(var(--c-gold));
    font-size: 0.5em;
    margin-right: 0.5em;
    vertical-align: 0.5em;
  }
  .post-body :global(h3) {
    font-size: 1.5em;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
    font-weight: 600;
    line-height: 1.3;
  }
  .post-body :global(h4) {
    font-size: 1.25em;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
    line-height: 1.4;
  }

  /* リスト */
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 1.25em 0;
    padding-left: 1.625em;
  }
  .post-body :global(ul) {
    list-style-type: disc;
  }
  .post-body :global(ul ul) {
    list-style-type: circle;
    margin: 0.5em 0;
  }
  .post-body :global(ul ul ul) {
    list-style-type: square;
  }
  .post-body :global(ol) {
    list-style-type: decimal;
  }
  .post-body :global(ol ol) {
    list-style-type: lower-alpha;
    margin: 0.5em 0;
  }
  .post-body :global(li) {
    margin: 0.5em 0;
    line-height: 1.8;
  }
  .post-body :global(li::marker) {
    color: rgb(var(--c-accent));
  }
  .post-body :global(li p) {
    margin: 0.5em 0;
  }
  .post-body :global(li > ul),
  .post-body :global(li > ol) {
    margin: 0.5em 0;
  }

  /* 引用: 銀の面+グレーの左線 */
  .post-body :global(blockquote) {
    margin: 1.6em 0;
    padding: 0.2em 1.25em;
    border-left: 3px solid rgb(var(--c-sub) / 0.45);
    border-radius: 0 0.5rem 0.5rem 0;
    background-color: rgb(var(--c-surface));
    color: rgb(var(--c-sub));
  }
  .post-body :global(blockquote p) {
    margin: 1em 0;
  }

  /* テーブル */
  .post-body :global(table) {
    width: 100%;
    margin: 2em 0;
    border-collapse: collapse;
  }
  .post-body :global(th) {
    padding: 0.75em 1em;
    background-color: rgb(var(--c-surface));
    border-bottom: 2px solid rgb(var(--c-line));
    font-weight: 600;
    text-align: left;
  }
  .post-body :global(td) {
    padding: 0.75em 1em;
    border-bottom: 1px solid rgb(var(--c-line));
  }
</style>
