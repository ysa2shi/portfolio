---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeadCommon from "@/components/HeadCommon.astro";
import HeadMeta, {
  type Props as HeadMetaProps,
} from "@/components/HeadMeta.astro";
import { siteConfig } from "@/config/site";
import { getI18n } from "@/i18n/utils";

interface Props extends Omit<HeadMetaProps, "title"> {
  pageTitle: string;
}

const { pageTitle, ...meta } = Astro.props;
const { lang, t } = getI18n(Astro.currentLocale);
const fullTitle = `${pageTitle} | ${siteConfig.name}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-theme="light">
  <head>
    <HeadCommon />
    <HeadMeta title={fullTitle} {...meta} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("rss.title")}
      href="/rss.xml"
    />

    <title>{fullTitle}</title>

    <script>
      // Service Workerの登録
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
    </script>
  </head>
  <body class="bg-canvas text-ink min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
    background-color: rgb(var(--c-canvas));
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  main {
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    line-height: 1.2;
    font-weight: 600;
  }

  h1 {
    font-size: 2.5rem;
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.5rem;
  }

  p {
    margin-bottom: 1rem;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @keyframes slideUp {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
