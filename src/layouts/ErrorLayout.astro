---
import HeadCommon from "@/components/HeadCommon.astro";
import ErrorHeader from "@/components/ErrorHeader.astro";
import Footer from "@/components/Footer.astro";
import { siteConfig } from "@/config/site";
import { toLang } from "@/i18n/utils";
const { pageTitle } = Astro.props;
const lang = toLang(Astro.currentLocale);
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-theme="light">
  <head>
    <HeadCommon />
    <meta name="robots" content="noindex" />
    <title>{pageTitle} | {siteConfig.name}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink flex flex-col">
    <ErrorHeader />
    <main class="flex-grow pt-24">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
