---
import { siteConfig } from "@/config/site";
import Button from "@/components/Button.astro";
import { toLang, useTranslations } from "@/i18n/utils";

const t = useTranslations(toLang(Astro.currentLocale));
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="w-full md:w-1/3">
        <div class="avatar">
          <svg viewBox="0 0 288 288" aria-hidden="true">
            <circle class="ring-base" cx="144" cy="144" r="136"></circle>
            <g class="orbit">
              <circle
                class="arc arc-tail"
                cx="144"
                cy="144"
                r="136"
                pathLength="100"></circle>
              <circle
                class="arc arc-mid"
                cx="144"
                cy="144"
                r="136"
                pathLength="100"></circle>
              <circle
                class="arc arc-head"
                cx="144"
                cy="144"
                r="136"
                pathLength="100"></circle>
              <circle class="spark" cx="102.0" cy="273.3" r="5"></circle>
            </g>
          </svg>
          <img
            src="/img/profile.webp"
            alt={t("about.avatarAlt")}
            class="h-64 w-64 rounded-full object-cover"
          />
        </div>
      </div>
      <div class="w-full md:w-2/3">
        <h2 class="section-title text-3xl font-bold mb-6">
          {t("about.title")}
        </h2>
        <p class="text-lg text-sub mb-6">{t("about.body")}</p>
        <div class="flex flex-wrap gap-4">
          <Button href={siteConfig.links.github} external>
            {t("about.github")}
          </Button>
          <Button href={siteConfig.links.x} variant="secondary" external>
            {t("about.contact")}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 18rem;
    height: 18rem;
    margin: 0 auto;
  }
  .avatar svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring-base {
    fill: none;
    stroke: #e5484d;
    stroke-width: 1.5;
    opacity: 0;
    animation:
      ring-in 0.8s ease-out 0.2s forwards,
      base-pulse 3s ease-in-out 1s infinite;
  }
  .orbit {
    transform-box: view-box;
    transform-origin: center;
    opacity: 0;
    animation:
      ring-in 0.8s ease-out 0.2s forwards,
      orbit-spin 6s linear infinite;
    filter: drop-shadow(0 0 8px rgb(229 72 77 / 0.9));
  }
  .arc {
    fill: none;
    stroke: #e5484d;
    stroke-linecap: round;
  }
  /* 彗星の尾: 先頭(全体の30%の位置)から後ろに向かって、長く・細く・薄く */
  .arc-tail {
    stroke-width: 2;
    stroke-dasharray: 30 70;
    stroke-dashoffset: 0;
    opacity: 0.35;
  }
  .arc-mid {
    stroke-width: 3.5;
    stroke-dasharray: 14 86;
    stroke-dashoffset: -16;
    opacity: 0.7;
  }
  .arc-head {
    stroke: #ff6b6f;
    stroke-width: 5;
    stroke-dasharray: 5 95;
    stroke-dashoffset: -25;
  }
  .spark {
    fill: #fff;
    filter: drop-shadow(0 0 6px #ff6b6f);
  }
  @keyframes ring-in {
    to {
      opacity: 1;
    }
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes base-pulse {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-base,
    .orbit {
      opacity: 1;
    }
  }
</style>
