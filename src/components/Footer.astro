---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
import { toLang, useTranslations } from "@/i18n/utils";

const t = useTranslations(toLang(Astro.currentLocale));
const currentYear = new Date().getFullYear();
const links = [
  { name: "GitHub", icon: "simple-icons:github", url: siteConfig.links.github },
  { name: "X", icon: "simple-icons:x", url: siteConfig.links.x },
  { name: "Zenn", icon: "simple-icons:zenn", url: siteConfig.links.zenn },
];
---

<footer class="border-t border-transparent py-20 text-sm text-sub footer-line">
  <div
    class="container mx-auto grid grid-cols-2 items-center gap-y-8 px-4 md:grid-cols-[1fr_auto_1fr]"
  >
    <div
      class="col-span-2 text-center md:col-span-1 md:col-start-2 md:row-start-1"
    >
      <h2 class="section-title mb-4 text-3xl font-bold text-ink">
        {t("footer.title")}
      </h2>
      <p class="mx-auto max-w-xl text-base !mb-0">
        {t("footer.lead")}
      </p>
    </div>
    <div class="md:col-start-1 md:row-start-1">
      <p class="!mb-1 text-xl font-bold text-ink">{siteConfig.name}</p>
      <p class="!mb-0 max-w-xs">{t("site.description")}</p>
    </div>
    <div
      class="flex flex-col items-end gap-3 justify-self-end md:col-start-3 md:row-start-1"
    >
      <ul class="flex gap-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.url}
                aria-label={link.name}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-line text-sub transition hover:border-accent-2 hover:text-accent-2"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={link.icon} class="h-5 w-5" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="!mb-0 text-xs">&copy; {currentYear} {siteConfig.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer-line {
    border-image: linear-gradient(
        90deg,
        transparent,
        rgb(var(--c-violet)),
        rgb(var(--c-accent)),
        transparent
      )
      1;
  }
</style>
