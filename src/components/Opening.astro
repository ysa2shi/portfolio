---
import { marketingConfig } from "@/config/marketing";
import Button from "@/components/Button.astro";
import { sparkPath } from "@/utils/sparkle";
import { getI18n, localizePath } from "@/i18n/utils";

const { lang, t } = getI18n(Astro.currentLocale);
const { blog, articles } = marketingConfig.pageInfo;

// 右側の星座。tone: hg=金 / ha=空色 / hw=銀白
const lines = [
  [80, 150, 250, 70],
  [250, 70, 330, 230],
  [330, 230, 420, 300],
  [250, 70, 470, 120],
  [80, 150, 150, 320],
  [150, 320, 330, 230],
] as const;
const stars = [
  { x: 80, y: 150, r: 17, tone: "hg" },
  { x: 250, y: 70, r: 9, tone: "ha" },
  { x: 330, y: 230, r: 11, tone: "ha" },
  { x: 470, y: 120, r: 7, tone: "hw" },
  { x: 420, y: 300, r: 8, tone: "hw" },
  { x: 150, y: 320, r: 6, tone: "hw" },
] as const;
---

<section class="relative overflow-hidden py-20 md:py-32">
  <div class="container relative z-10 mx-auto px-4">
    <svg class="hero-sky" viewBox="0 0 540 380" aria-hidden="true">
      {lines.map(([x1, y1, x2, y2]) => <line class="hl" {x1} {y1} {x2} {y2} />)}
      {
        stars.map(({ x, y, r, tone }, i) => (
          <path
            class={`hs ${tone}`}
            style={`animation-delay:${i * 0.9}s`}
            d={sparkPath(x, y, r)}
          />
        ))
      }
    </svg>
    <div class="relative max-w-3xl">
      <h1 class="mb-6 text-4xl font-bold md:text-5xl lg:text-6xl">
        Software <em class="gradient-text">Engineer</em>
      </h1>
      <p class="mb-8 text-xl text-sub md:text-2xl">
        {t("hero.lead")}
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href={localizePath(blog.href, lang)}>{t("hero.blog")}</Button>
        <Button href={localizePath(articles.href, lang)} variant="secondary">
          {t("hero.articles")}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-sky {
    position: absolute;
    top: -40px;
    right: 16px;
    width: min(46%, 500px);
    height: auto;
    pointer-events: none;
  }
  .hl {
    stroke: rgb(var(--c-accent));
    stroke-width: 1;
    opacity: 0.35;
  }
  .hs {
    transform-box: fill-box;
    transform-origin: center;
    animation: hsp 6s ease-in-out infinite;
  }
  .hg {
    fill: rgb(var(--c-gold));
    filter: drop-shadow(0 0 8px rgb(var(--c-gold) / 0.6));
  }
  .ha {
    fill: rgb(var(--c-accent));
  }
  .hw {
    fill: rgb(var(--c-star));
  }
  @keyframes hsp {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @media (max-width: 640px) {
    .hero-sky {
      width: 70%;
      top: -30px;
      opacity: 0.5;
    }
  }
</style>
