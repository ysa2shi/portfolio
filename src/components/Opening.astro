---
import { marketingConfig } from "@/config/marketing";
import Button from "@/components/Button.astro";
import { localizePath, toLang, useTranslations } from "@/i18n/utils";

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const { blog, articles } = marketingConfig.pageInfo;
---

<section class="relative overflow-hidden py-20 md:py-32">
  <div class="container relative z-10 mx-auto px-4">
    <svg class="hero-sky" viewBox="0 0 540 380" aria-hidden="true">
      <line class="hl" x1="80" y1="150" x2="250" y2="70"></line>
      <line class="hl" x1="250" y1="70" x2="330" y2="230"></line>
      <line class="hl" x1="330" y1="230" x2="420" y2="300"></line>
      <line class="hl" x1="250" y1="70" x2="470" y2="120"></line>
      <line class="hl" x1="80" y1="150" x2="150" y2="320"></line>
      <line class="hl" x1="150" y1="320" x2="330" y2="230"></line>
      <path
        class="hs hg"
        style="animation-delay:0.0s"
        d="M80,133 Q80,150 97,150 Q80,150 80,167 Q80,150 63,150 Q80,150 80,133Z"
      ></path>
      <path
        class="hs ha"
        style="animation-delay:0.9s"
        d="M250,61 Q250,70 259,70 Q250,70 250,79 Q250,70 241,70 Q250,70 250,61Z"
      ></path>
      <path
        class="hs ha"
        style="animation-delay:1.8s"
        d="M330,219 Q330,230 341,230 Q330,230 330,241 Q330,230 319,230 Q330,230 330,219Z"
      ></path>
      <path
        class="hs hw"
        style="animation-delay:2.7s"
        d="M470,113 Q470,120 477,120 Q470,120 470,127 Q470,120 463,120 Q470,120 470,113Z"
      ></path>
      <path
        class="hs hw"
        style="animation-delay:3.6s"
        d="M420,292 Q420,300 428,300 Q420,300 420,308 Q420,300 412,300 Q420,300 420,292Z"
      ></path>
      <path
        class="hs hw"
        style="animation-delay:4.5s"
        d="M150,314 Q150,320 156,320 Q150,320 150,326 Q150,320 144,320 Q150,320 150,314Z"
      ></path>
    </svg>
    <div class="relative max-w-3xl">
      <h1 class="mb-6 text-4xl font-bold md:text-5xl lg:text-6xl">
        Software <em class="gradient-text">Engineer</em>
      </h1>
      <p class="mb-8 text-xl text-sub md:text-2xl">
        {t("hero.lead")}
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href={localizePath(blog.href, lang)}>{t("hero.blog")}</Button>
        <Button href={localizePath(articles.href, lang)} variant="secondary">
          {t("hero.articles")}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-sky {
    position: absolute;
    top: -40px;
    right: 16px;
    width: min(46%, 500px);
    height: auto;
    pointer-events: none;
  }
  .hl {
    stroke: rgb(var(--c-accent));
    stroke-width: 1;
    opacity: 0.35;
  }
  .hs {
    transform-box: fill-box;
    transform-origin: center;
    animation: hsp 6s ease-in-out infinite;
  }
  .hg {
    fill: rgb(var(--c-gold));
    filter: drop-shadow(0 0 8px rgb(var(--c-gold) / 0.6));
  }
  .ha {
    fill: rgb(var(--c-accent));
  }
  .hw {
    fill: rgb(var(--c-star));
  }
  @keyframes hsp {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @media (max-width: 640px) {
    .hero-sky {
      width: 70%;
      top: -30px;
      opacity: 0.5;
    }
  }
</style>
