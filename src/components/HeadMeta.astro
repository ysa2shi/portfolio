---
import { siteConfig } from "@/config/site";
import { languages } from "@/i18n/ui";
import { toLang, useTranslations } from "@/i18n/utils";

// 検索エンジンと SNS 向けのメタ情報(description・canonical・OGP・X のカード)
export interface Props {
  title: string;
  description?: string;
  /** サイト内のパスか絶対 URL。なければ共通の OGP 画像 */
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og.png",
  type = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const desc = description ?? t("site.description");
// PUBLIC_SITE_URL が未設定・不正(http(s):// がないなど)のときは、表示中のオリジンを使う
const base = /^https?:\/\//.test(siteConfig.url)
  ? siteConfig.url
  : Astro.url.origin;
const canonical = new URL(Astro.url.pathname, base).href;
const imageUrl = new URL(image, base).href;
const ogLocale = { ja: "ja_JP", en: "en_US" } satisfies Record<
  keyof typeof languages,
  string
>;
---

<meta name="description" content={desc} />
{
  noindex ? (
    <meta name="robots" content="noindex" />
  ) : (
    <link rel="canonical" href={canonical} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={ogLocale[lang]} />
{
  publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={imageUrl} />
