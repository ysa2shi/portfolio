---
import { normalizeSlug } from "@/utils/getCollectionPosts";
import Tag from "@/components/Tag.astro";

export interface Props {
  id: string;
  title: string;
  image?: {
    url: string;
    alt: string;
  };
  publishDate: Date;
  tags?: string[];
}

const id = normalizeSlug(Astro.props.id);
const { title, image, tags = [] } = Astro.props;
---

<article
  class="group overflow-hidden rounded-2xl border border-line bg-surface transition duration-300 hover:-translate-y-0.5 hover:border-accent-2 hover:shadow-[0_10px_30px_-18px_rgb(var(--c-accent-2))]"
>
  {
    image && (
      <a href={`/blog/${id}`} class="block">
        <div class="aspect-video overflow-hidden">
          <img
            src={image.url}
            alt={image.alt || `Thumbnail for ${title}`}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      </a>
    )
  }

  <div class="p-6">
    <a href={`/blog/${id}`} class="block">
      <h3 class="text-xl font-semibold mb-2 text-ink">
        {title}
      </h3>
    </a>

    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>
  </div>
</article>
