---
import ArticleCard from "@/components/ArticleCard.astro";
import SectionPreview from "@/components/SectionPreview.astro";
import { fetchZennArticles } from "@/utils/fetchZennFeed";
const articles = await fetchZennArticles();

// 最新3件だけ表示
const latestArticles = articles.slice(0, 3);
---

<SectionPreview
  title="Latest Articles"
  description="An overview of my recent thoughts and developments within the technology field."
  href="/articles"
  linkLabel="View All Articles"
>
  {
    latestArticles.map((article) => (
      <ArticleCard
        title={article.title}
        description={article.description}
        publishDate={article.pubDate}
        link={article.link}
      />
    ))
  }
</SectionPreview>
