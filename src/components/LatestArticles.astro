---
import ArticleCard from "@/components/ArticleCard.astro";
import SectionPreview from "@/components/SectionPreview.astro";
import { fetchZennArticles } from "@/utils/fetchZennFeed";
import { marketingConfig } from "@/config/marketing";
import { getI18n, localizePath, localized } from "@/i18n/utils";

const { lang, t } = getI18n(Astro.currentLocale);
const text = localized(lang, {
  ja: { title: "Latest Articles", viewAll: "View All Articles" },
  en: {},
});
const page = marketingConfig.pageInfo.articles;
const articles = await fetchZennArticles();

// 最新3件だけ表示
const latestArticles = articles.slice(0, 3);
---

<SectionPreview
  title={text.title}
  description={t(page.description)}
  href={localizePath(page.href, lang)}
  linkLabel={text.viewAll}
>
  {
    latestArticles.map((article) => (
      <ArticleCard
        title={article.title}
        description={article.description}
        publishDate={article.pubDate}
        link={article.link}
      />
    ))
  }
</SectionPreview>
