---
import { getI18n, localized } from "@/i18n/utils";

const { lang } = getI18n(Astro.currentLocale);
const text = localized(lang, { ja: { title: "Timeline" }, en: {} });

interface Experience {
  date: string;
  title: string;
  description?: string;
}

// 新しい順
const experiences: Experience[] = [
  {
    date: "2026.04",
    ...localized(lang, {
      ja: { title: "AI 開発を勉強中" },
      en: { title: "Currently learning AI development" },
    }),
  },
  {
    date: "2025.04",
    ...localized(lang, {
      ja: {
        title: "フロントエンドの勉強を始める",
        description: "学んだことを試す場として、このサイトを作りました。",
      },
      en: {
        title: "Started learning frontend development",
        description:
          "Created this portfolio site as a project to apply what I've learned.",
      },
    }),
  },
  {
    date: "2024.04",
    ...localized(lang, {
      ja: {
        title: "決済機能の開発・運用を担当",
        description:
          "AWS 上で動く Java × Spring Boot のアプリケーションを開発しています。",
      },
      en: {
        title: "Developing and operating payment features",
        description:
          "Working on Java × Spring Boot applications running on AWS.",
      },
    }),
  },
  {
    date: "2023.04",
    ...localized(lang, {
      ja: {
        title: "新卒で現職に入社",
        description: "Web アプリケーションの開発に配属。",
      },
      en: {
        title: "Joined current company as a new graduate engineer",
        description: "Mainly working as a web developer.",
      },
    }),
  },
  {
    date: "2023.03",
    ...localized(lang, {
      ja: {
        title: "大学院 修士課程修了(工学専攻)",
        description: "深層学習を使った音声合成を研究していました。",
      },
      en: {
        title: "Master of Engineering (M.Eng.)",
        description: "Researched speech synthesis with deep learning.",
      },
    }),
  },
];
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="section-title mb-12 text-center text-3xl font-bold">
      {text.title}
    </h2>
    <div class="mx-auto max-w-3xl">
      {
        experiences.map((experience, i) => (
          <div class="mb-10 flex gap-6 last:mb-0">
            <div class="w-24 flex-shrink-0 pt-0.5 text-right">
              <span class="font-semibold text-accent">{experience.date}</span>
            </div>
            <div class="relative flex-grow border-l border-line pb-2 pl-6">
              <span
                class:list={[
                  "absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full",
                  i === 0
                    ? "bg-gold shadow-[0_0_8px_rgb(var(--c-gold))]"
                    : "bg-accent",
                ]}
              />
              <h3 class="mb-2 text-xl font-semibold">{experience.title}</h3>
              {experience.description && (
                <p class="text-sub">{experience.description}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
