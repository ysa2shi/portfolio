---
const experiences = [
  {
    yyyymm: "2025.04",
    title: "Currently learning frontend development",
    description:
      "Created this portfolio site as a project to apply what I've learned.",
  },
  {
    yyyymm: "2024.04",
    title: "Engaged in backend development for payment systems",
    description:
      "Working on Java + Spring Boot web applications in AWS environment.",
  },
  {
    yyyymm: "2023.04",
    title: "Joined current company as a new graduate engineer",
    description: "Mainly working as a web developer.",
  },
  {
    yyyymm: "2023.03",
    title: "M.Eng in Compute Science",
    description: "Researched speech synthesis with deep learning.",
  },
];
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="section-title mb-12 text-center text-3xl font-bold">Timeline</h2>
    <div class="mx-auto max-w-3xl">
      {
        experiences.map((experience, i) => (
          <div class="mb-10 flex gap-6 last:mb-0">
            <div class="w-24 flex-shrink-0 pt-0.5 text-right">
              <span class="font-semibold text-accent">{experience.yyyymm}</span>
            </div>
            <div class="relative flex-grow border-l border-line pb-2 pl-6">
              <span
                class:list={[
                  "absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full",
                  i === 0
                    ? "bg-gold shadow-[0_0_8px_rgb(var(--c-gold))]"
                    : "bg-accent",
                ]}
              />
              <h3 class="mb-2 text-xl font-semibold">{experience.title}</h3>
              <p class="text-sub">{experience.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
