---
import { baseUI, type UIKey } from "@/i18n/ui";
import { toLang, useTranslations } from "@/i18n/utils";

const t = useTranslations(toLang(Astro.currentLocale));

// 文言は辞書の timeline.<年月>.title / description(description は省略可)
const experiences = (
  [
    ["2026.04", "timeline.202604"],
    ["2025.04", "timeline.202504"],
    ["2024.04", "timeline.202404"],
    ["2023.04", "timeline.202304"],
    ["2023.03", "timeline.202303"],
  ] as const
).map(([yyyymm, key]) => {
  const descKey = `${key}.description`;
  return {
    yyyymm,
    title: t(`${key}.title`),
    description: descKey in baseUI ? t(descKey as UIKey) : undefined,
  };
});
---

<section class="py-20">
  <div class="container mx-auto px-4">
    <h2 class="section-title mb-12 text-center text-3xl font-bold">
      {t("timeline.title")}
    </h2>
    <div class="mx-auto max-w-3xl">
      {
        experiences.map((experience, i) => (
          <div class="mb-10 flex gap-6 last:mb-0">
            <div class="w-24 flex-shrink-0 pt-0.5 text-right">
              <span class="font-semibold text-accent">{experience.yyyymm}</span>
            </div>
            <div class="relative flex-grow border-l border-line pb-2 pl-6">
              <span
                class:list={[
                  "absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full",
                  i === 0
                    ? "bg-gold shadow-[0_0_8px_rgb(var(--c-gold))]"
                    : "bg-accent",
                ]}
              />
              <h3 class="mb-2 text-xl font-semibold">{experience.title}</h3>
              {experience.description && (
                <p class="text-sub">{experience.description}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
