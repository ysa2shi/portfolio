---
import { marketingConfig } from "@/config/marketing";
import { siteConfig } from "@/config/site";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LangSwitch from "@/components/LangSwitch.astro";
import { getI18n, localizePath } from "@/i18n/utils";

const { lang, t } = getI18n(Astro.currentLocale);
const { home, blog, articles, talks } = marketingConfig.pageInfo;
const navItems = [home, blog, articles, talks].map((page) => ({
  name: t(page.title),
  url: localizePath(page.href, lang),
}));

const currentPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---

<header
  class="sticky top-0 z-50 w-full border-b border-line bg-canvas/85 py-3 backdrop-blur-md"
>
  <div class="container mx-auto px-4 flex justify-between items-center">
    <a
      href={localizePath("/", lang)}
      class="py-4 text-xl font-bold text-ink transition-colors hover:text-accent"
    >
      {siteConfig.name}
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden md:block">
        <ul class="flex space-x-8">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.url}
                  class={`border-b pb-0.5 transition-colors hover:border-accent-2 hover:text-ink ${
                    currentPath === item.url
                      ? "border-accent-2 text-ink"
                      : "border-transparent text-sub"
                  }`}
                  aria-current={currentPath === item.url ? "page" : undefined}
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <LangSwitch />
      <ThemeToggle />
      <button
        id="menuToggle"
        class="md:hidden p-2 text-ink"
        aria-label={t("nav.openMenu")}
        aria-controls="mobileMenu"
        aria-expanded="false"
        data-label-open={t("nav.openMenu")}
        data-label-close={t("nav.closeMenu")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobileMenu"
    class="hidden md:hidden fixed w-full border-b border-line bg-canvas py-4"
  >
    <nav class="container mx-auto px-4 text-center">
      <ul class="space-y-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.url}
                class={`block py-2 transition-colors hover:text-ink ${
                  currentPath === item.url ? "text-ink" : "text-sub"
                }`}
                aria-current={currentPath === item.url ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener("click", () => {
      const expanded =
        menuToggle.getAttribute("aria-expanded") === "true" || false;
      menuToggle.setAttribute("aria-expanded", (!expanded).toString());
      menuToggle.setAttribute(
        "aria-label",
        (expanded
          ? menuToggle.dataset.labelOpen
          : menuToggle.dataset.labelClose) ?? "",
      );
      mobileMenu.classList.toggle("hidden");

      // Change the icon when menu is open
      const svg = menuToggle.querySelector("svg");
      if (svg) {
        if (expanded) {
          svg.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>';
        } else {
          svg.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>';
        }
      }
    });
  }
</script>
