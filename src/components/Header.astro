---
import { marketingConfig } from "@/config/marketing";
import { siteConfig } from "@/config/site";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LangSwitch from "@/components/LangSwitch.astro";
import { getI18n, localizePath } from "@/i18n/utils";

const { lang, t } = getI18n(Astro.currentLocale);
const { home, blog, articles, talks } = marketingConfig.pageInfo;
const currentPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const homeUrl = localizePath(home.href, lang);
const navItems = [home, articles, talks, blog].map((page) => {
  const url = localizePath(page.href, lang);
  // 配下のページ(ブログ記事など)でも、そのナビを現在地として示す。トップだけは完全一致
  const current =
    currentPath === url ||
    (url !== homeUrl && currentPath.startsWith(`${url}/`));
  return { name: t(page.title), url, current };
});
---

<header
  class="sticky top-0 z-50 w-full border-b border-line bg-canvas/85 py-3 backdrop-blur-md"
>
  <div class="container mx-auto px-4 flex justify-between items-center">
    <a
      href={homeUrl}
      class="py-4 text-xl font-bold text-ink transition-colors hover:text-accent"
    >
      {siteConfig.name}
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden md:block">
        <ul class="flex space-x-8">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.url}
                  class={`border-b pb-0.5 transition-colors hover:border-accent-2 hover:text-ink ${
                    item.current
                      ? "border-accent-2 text-ink"
                      : "border-transparent text-sub"
                  }`}
                  aria-current={item.current ? "page" : undefined}
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <LangSwitch />
      <ThemeToggle />
      <button
        id="menuToggle"
        type="button"
        class="md:hidden p-2 text-ink"
        aria-label={t("nav.openMenu")}
        aria-controls="mobileMenu"
        aria-expanded="false"
        data-label-open={t("nav.openMenu")}
        data-label-close={t("nav.closeMenu")}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <path class="icon-open" d="M4 6h16M4 12h16M4 18h16"></path>
          <path class="icon-close" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobileMenu"
    class="hidden md:hidden fixed w-full border-b border-line bg-canvas py-4"
  >
    <nav class="container mx-auto px-4 text-center">
      <ul class="space-y-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.url}
                class={`block py-2 transition-colors hover:text-ink ${
                  item.current ? "text-ink" : "text-sub"
                }`}
                aria-current={item.current ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* 開いているあいだは × を出す(状態は aria-expanded で持つ) */
  #menuToggle .icon-close,
  #menuToggle[aria-expanded="true"] .icon-open {
    display: none;
  }
  #menuToggle[aria-expanded="true"] .icon-close {
    display: inline;
  }
</style>

<script>
  const menuToggle = document.getElementById("menuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener("click", () => {
      const open = menuToggle.getAttribute("aria-expanded") !== "true";
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute(
        "aria-label",
        (open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen) ??
          "",
      );
      mobileMenu.classList.toggle("hidden", !open);
    });
  }
</script>
