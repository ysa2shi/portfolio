---
import { getPosts, sortPosts } from "@/utils/getCollectionPosts";
import type { Post } from "@/types";
import { marketingConfig } from "@/config/marketing";
import PostCard from "@/components/PostCard.astro";
import SectionPreview from "@/components/SectionPreview.astro";

const posts: Post[] = await getPosts();
const latestPosts: Post[] = sortPosts(posts);
---

<SectionPreview
  title="Personal Blog"
  description={marketingConfig.pageInfo.blog.description}
  href={marketingConfig.pageInfo.blog.href}
  linkLabel="View All Posts"
  class="bg-neutral-50"
>
  {
    latestPosts.map((post: Post) => (
      <PostCard
        id={post.id}
        title={post.data.title}
        publishDate={post.data.publishDate}
        image={post.data.image}
        tags={post.data.tags ?? []}
      />
    ))
  }
</SectionPreview>
