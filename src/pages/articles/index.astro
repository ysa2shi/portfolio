---
import { fetchZennArticles } from "@/utils/fetchZennFeed";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { marketingConfig } from "@/config/marketing";
import PageHeader from "@/components/PageHeader.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { getI18n } from "@/i18n/utils";

const { t } = getI18n(Astro.currentLocale);
const page = marketingConfig.pageInfo.articles;
const articles = await fetchZennArticles();
---

<BaseLayout
  pageTitle={t(page.title)}
  description={page.description && t(page.description)}
>
  <PageHeader
    title={t(page.title)}
    description={page.description && t(page.description)}
  />

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          articles.map((article) => (
            <ArticleCard
              title={article.title}
              description={article.description}
              publishDate={article.pubDate}
              link={article.link}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
