---
import type { Project } from "../../../types"
import BaseLayout from "../../layouts/BaseLayout.astro"
import PageHeader from "../../components/PageHeader.astro"
import ProjectCard from "../../components/ProjectCard.astro"
import { getProjects, sortProjects } from "../../utils/getCollectionProjects"

const featuredProjects: Project[] = await getProjects()
const sortedProjects: Project[] = sortProjects(featuredProjects)
---

<BaseLayout
  title="Portfolio - Projects"
  description="Explore my portfolio of web development and design projects"
>
  <PageHeader
    title="Projects"
    description="I would like to introduce some projects I’ve recently completed."
  />

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div
        class="text-3xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {
          sortedProjects.map((project: Project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              emoji={project.data.emoji}
              publishDate={project.data.publishDate}
              image={project.data.image.url}
              tags={project.data.tags}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
