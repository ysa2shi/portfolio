---
import type { Project } from "../../../types"
import MarkdownProjectLayout from "../../layouts/MarkdownProjectLayout.astro"
import { type CollectionEntry } from "astro:content"
import { getProjects } from "../../utils/getCollectionProjects"

interface Props {
  post: CollectionEntry<"projects">
}

export async function getStaticPaths() {
  const featuredProjects: Project[] = await getProjects()

  return featuredProjects.map((post: Project) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }))
}
const { post } = Astro.props as Props
const { Content } = await post.render()
---

<MarkdownProjectLayout frontmatter={post.data} pageTitle={post.data.title}>
  <Content />
</MarkdownProjectLayout>
